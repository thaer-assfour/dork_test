# DorkHub configuration. Copy to .env and fill in. Never commit .env.

# Core
DORKHUB_SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -m app.cli set-password "your-password"
DORKHUB_AUTH_PASSWORD_HASH=

# Database: SQLite (default, easy) or Postgres (compose).
DORKHUB_DATABASE_URL=sqlite:///./dorkhub.db
# DORKHUB_DATABASE_URL=postgresql+psycopg://dorkhub:dorkhub@postgres:5432/dorkhub

# Task backend: "sync" (inline, no Redis) or "rq" (Redis worker).
DORKHUB_TASK_BACKEND=sync
DORKHUB_REDIS_URL=redis://localhost:6379/0

# Search providers (keys live here only, never in the DB).
DORKHUB_SERPER_API_KEY=
DORKHUB_DATAFORSEO_LOGIN=
DORKHUB_DATAFORSEO_PASSWORD=

# Default engine shown in the UI.
DORKHUB_DEFAULT_ENGINE=serper

# Cost / safety controls.
DORKHUB_CACHE_TTL_HOURS=72
DORKHUB_MAX_MERGE_TERMS=8
DORKHUB_COST_WARN_THRESHOLD_USD=20
DORKHUB_RATE_LIMIT_PER_SEC=2
